{
  "name": "@tagpilot/search-console-mcp",
  "version": "0.1.0",
  "mcpName": "io.github.tagpilot/search-console-mcp",
  "description": "Free, read-only Google Search Console MCP server by Tag Pilot. Zero Google Cloud setup: approve in your browser, then query search performance, opportunities, URL inspection and sitemaps from Claude, Cursor and other MCP clients.",
