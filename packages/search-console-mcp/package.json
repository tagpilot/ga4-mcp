    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "google-search-console",
    "search-console",
    "seo",
    "tagpilot"
  ],
  "homepage": "https://tagpilot.io/search-console-mcp",
  "scripts": {
    "build": "node ../../scripts/build.mjs search-console-mcp",
    "e2e": "node scripts/e2e.mjs",
