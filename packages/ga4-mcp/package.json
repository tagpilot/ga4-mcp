{
  "name": "@tagpilot/ga4-mcp",
  "version": "0.3.0",
  "mcpName": "io.github.tagpilot/ga4-mcp",
  "description": "Free, read-only Google Analytics 4 MCP server by Tag Pilot. Zero Google Cloud setup: sign in with Google in your browser, query GA4 from Claude, Cursor and other MCP clients.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "ga4-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "google-analytics",
    "ga4",
    "analytics",
    "tagpilot"
  ],
  "homepage": "https://tagpilot.io/ga4-mcp",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.1.0"
  },
  "author": "Tag Concierge sp. z o.o. (https://tagpilot.io)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tagpilot/ga4-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/tagpilot/ga4-mcp/issues"
  },
  "scripts": {
    "build": "node ../../scripts/build.mjs ga4-mcp",
    "e2e": "node scripts/e2e.mjs",
    "mcpb": "node ../../scripts/build-mcpb.mjs ga4-mcp",
    "mcpb:smoke": "node ../../scripts/mcpb-smoke.mjs ga4-mcp",
    "prepublishOnly": "npm --prefix ../.. run check && npm run build"
  }
}
